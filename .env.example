# KayaBot configuration — copy the values into your environment.
#
# This file contains placeholders only. Never put real credentials in it;
# it exists to document which variables the bot reads.

# Login credentials for kaya.ir (required).
KAYA_USERNAME=your_username
KAYA_PASSWORD=your_password

# Run Chrome with a visible window instead of headless (optional, default: false).
# Useful for troubleshooting the first login.
KAYA_DEBUG=false

# Disable Chrome's process sandbox (optional, default: false).
# Only set this when running as root inside a container.
KAYA_NO_SANDBOX=false
